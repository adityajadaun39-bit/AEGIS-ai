# AEGIS Gateway Configuration
AEGIS_APP_NAME=AEGIS
AEGIS_APP_VERSION=0.2.0
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000

# Authentication Tokens
AEGIS_ADMIN_TOKEN=aegis-admin-secret-token-demo
AEGIS_APPROVER_TOKEN=aegis-approver-secret-token-demo
AEGIS_AGENT_TOKEN_RESEARCH_AGENT=aegis-research-agent-token
AEGIS_AGENT_TOKEN_SUPERVISED_RESEARCH_AGENT=aegis-supervised-agent-token

# Security Engine Options
# Set OPA_PATH if using external OPA binary. Leave blank for built-in in-process policy engine.
OPA_PATH=
AEGIS_ML_ENABLED=false
